BLUESKY_HANDLE=your-handle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
BLUESKY_PDS_HOST=https://bsky.social
BRIGHTCOVE_BASE_URL=https://edge.api.brightcove.com/playback/v1
BRIGHTCOVE_ACCOUNT_ID=<your-account-id>
BRIGHTCOVE_POLICY_KEY=<your-key>
NHL_WEB_API_BASE_URL=https://api-web.nhle.com
NHL_STATS_API_BASE_URL=https://api.nhle.com/stats/rest
HTTP_TIMEOUT=10.0
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_FACTOR=0.5
APP_TIMEZONE=America/Toronto
RUN_WORKERS=1
FOLLOWED_TEAM_ABBREVIATION=TOR
LOG_LEVEL=INFO
ENV=dev

# Postgres. In compose, DB_* default to the POSTGRES_* values (see compose.yaml),
# so .env only needs POSTGRES_* plus a DB_HOST override when running the API or
# alembic from the host instead of inside a container.
POSTGRES_USER=bluesky
POSTGRES_PASSWORD=changeme-only-in-your-local-dot-env
POSTGRES_DB=bluesky_bot
DB_HOST=db
DB_PORT=5432
DB_USER=bluesky
DB_PASSWORD=changeme-only-in-your-local-dot-env
DB_NAME=bluesky_bot
